#!/bin/bash
# ============================================================================
# vae_covsel_array.lsf
# ----------------------------------------------------------------------------
# LSF job-array template for the VAE one-run covariate-selection pilot.
# ONE task per (N, scenario, structure, dataset_id); array index = dataset id.
#
# Submitted via script/hpce_vae_covsel/submit_one_array.sh, which sets -J/-o/-e
# and injects env vars via `bsub -env`.
#
# Resources per task (TUNED from N80 scn16 linCmt probe: 1.3 GB peak, 44 s):
#   2 CPU   (VAE fit is effectively single-threaded; ~28% eff on 4 cores)
#   2500 MB (measured 1.3 GB peak; headroom for N300/ode)
#   30 min walltime  (probe 44 s; wide margin for N300/ode)
# Raise -M / -W if N300 or ode cells approach these limits.
#
# NOTE  est = "vae" is a NATIVE C++/Armadillo engine (no `torch` / libtorch
#       dependency). The only optional extra is `L0Learn` (large covariate
#       searches only); the four-covariate grid here uses exact branch-and-bound
#       and does not need it. A genuine fit error still writes
#       res_ds<DDD>_ERROR.txt and exits non-zero (loud fail).
# ============================================================================

#BSUB -n 2
#BSUB -R "span[hosts=1]"
#BSUB -M 2500
#BSUB -W 00:30

set -euo pipefail

: "${REPO_ROOT:?REPO_ROOT must be set}"
: "${SCRIPTS_DIR:?SCRIPTS_DIR must be set (subdir with vae_covsel_driver.R)}"
: "${SAMPLE_N:?SAMPLE_N must be set (40|80|300)}"
: "${SCN:?SCN must be set (1..16)}"
: "${STRUCTURE:?STRUCTURE must be set (linCmt|ode)}"
: "${LSB_JOBINDEX:?LSB_JOBINDEX must be set (LSF populates for job arrays)}"

OUT_ROOT="${OUT_ROOT:-output/vae_covsel_pilot}"
SHAPES="${SHAPES:-power lin}"

echo "=========================================================="
echo "Task started : $(date)"
echo "Job ID       : ${LSB_JOBID}"
echo "Job name     : ${LSB_JOBNAME}"
echo "Array idx    : ${LSB_JOBINDEX}"
echo "Host         : $(hostname)"
echo "Sample N     : ${SAMPLE_N}"
echo "Scenario     : ${SCN}"
echo "Structure    : ${STRUCTURE}"
echo "Dataset      : ${LSB_JOBINDEX}"
echo "Out root     : ${OUT_ROOT}"
echo "Repo root    : ${REPO_ROOT}"
echo "=========================================================="

if command -v module >/dev/null 2>&1; then
  module load R
fi

cd "$REPO_ROOT"

Rscript "$SCRIPTS_DIR/vae_covsel_driver.R" \
    --N         "$SAMPLE_N" \
    --scenario  "$SCN" \
    --structure "$STRUCTURE" \
    --dataset   "$LSB_JOBINDEX" \
    --out_root  "$OUT_ROOT" \
    --shapes    "$SHAPES"

exit_code=$?
echo "=========================================================="
echo "Task finished : $(date)"
echo "Exit code     : ${exit_code}"
echo "=========================================================="
exit ${exit_code}
