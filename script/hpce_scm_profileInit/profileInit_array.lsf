#!/bin/bash
# ============================================================================
# profileInit_array.lsf
# ----------------------------------------------------------------------------
# LSF job template for the profileInit warm-start A/B experiment on scn16
# (the most complex scenario, all four true covariates).
#
# ONE task per (cell x arm x structure). Drives script/_ab_profileInit_scn16.R
# via env vars it reads directly:
#   AB_CELL / AB_ARM / AB_STRUCTURE   -- the single (cell,arm,structure)
#   AB_WORKERS / AB_RXTHREADS         -- parallelism knobs
#
# Submitted via script/hpce_profileInit/submit_one.sh, which sets -J/-o/-e and
# injects the env vars with `bsub -env`.
#
# Resources per task (one forward SCM + tight-tol refit; ODE is the heavy case):
#   AB_WORKERS x AB_RXTHREADS CPUs (default 3x2 = 6) on a single host
#   8000 MB RAM (ODE analytic-gradient compile + candidate fits)
#   06:00 walltime (ODE irlsfoceif forward SCM can run a few hours; linCmt is
#                   much faster -- pad generously).
# Scale up by requesting more cores and raising AB_WORKERS/AB_RXTHREADS.
# ============================================================================

#BSUB -n 6
#BSUB -R "span[hosts=1]"
#BSUB -M 8000
#BSUB -W 06:00

set -euo pipefail

: "${REPO_ROOT:?REPO_ROOT must be set}"
: "${SCRIPTS_DIR:?SCRIPTS_DIR must be set (subdir with _ab_profileInit_scn16.R)}"
: "${AB_CELL:?AB_CELL must be set (irlsfoceif_lbfgsb3c|focei_nlminb|focei_lbfgsb3c)}"
: "${AB_ARM:?AB_ARM must be set (profileOff|profileOn)}"
: "${AB_STRUCTURE:?AB_STRUCTURE must be set (linCmt|ode)}"

export AB_WORKERS="${AB_WORKERS:-3}"
export AB_RXTHREADS="${AB_RXTHREADS:-2}"

echo "=========================================================="
echo "Task started : $(date)"
echo "Job ID       : ${LSB_JOBID:-NA}"
echo "Host         : $(hostname)"
echo "Cell         : ${AB_CELL}"
echo "Arm          : ${AB_ARM}"
echo "Structure    : ${AB_STRUCTURE}"
echo "Workers      : ${AB_WORKERS} x rxThreads ${AB_RXTHREADS}"
echo "Repo root    : ${REPO_ROOT}"
echo "=========================================================="

if command -v module >/dev/null 2>&1; then
  module load R || true
fi

cd "$REPO_ROOT"
Rscript "$SCRIPTS_DIR/_ab_profileInit_scn16.R"

exit_code=$?
echo "Task finished : $(date)   exit=${exit_code}"
exit ${exit_code}
