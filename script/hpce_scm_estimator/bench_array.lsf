#!/bin/bash
# ============================================================================
# bench_array.lsf
# ----------------------------------------------------------------------------
# LSF job-array template for the SCM estimator x optimizer benchmark.
# ONE task per (N, scenario, estimator, outer_opt, dataset_id).
#
# Submitted via script/hpce_bench/submit_one_array.sh which sets -J/-o/-e
# and injects env vars via `bsub -env`.
#
# Resources per task (one SCM run + tight-tol refit or in-fit cov):
#   4 CPU  -- SCM forks 3 workers (rxThreads PINNED to 1 in the driver, so the
#             fork is clean: fork()-over-OpenMP is undefined and corrupts the
#             ODE solve). 4 slots leaves headroom over the 3 fork workers.
#   3000 MB RAM (classical focei peaks ~1.8 GB; 3 GB is a safe ceiling)
#   180 min walltime (typical N=80 fit wall ~5-8 min; ode/larger N longer)
# ============================================================================

#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -M 3000
#BSUB -W 03:00

set -euo pipefail

: "${REPO_ROOT:?REPO_ROOT must be set}"
: "${SCRIPTS_DIR:?SCRIPTS_DIR must be set (subdir with PerformanceEvaluation_scm_bench.R)}"
: "${SAMPLE_N:?SAMPLE_N must be set (40|80|300)}"
: "${SCN:?SCN must be set (1..16)}"
: "${EST:?EST must be set (focei|foceif|irlsfoceif|vae)}"
: "${OPT:?OPT must be set (bobyqa|nlminb|lbfgsb3c|NA)}"
: "${STRUCTURE:?STRUCTURE must be set (linCmt|ode)}"
: "${LSB_JOBINDEX:?LSB_JOBINDEX must be set (LSF populates for job arrays)}"

echo "=========================================================="
echo "Task started : $(date)"
echo "Job ID       : ${LSB_JOBID}"
echo "Job name     : ${LSB_JOBNAME}"
echo "Array idx    : ${LSB_JOBINDEX}"
echo "Host         : $(hostname)"
echo "Sample N     : ${SAMPLE_N}"
echo "Scenario     : ${SCN}"
echo "Estimator    : ${EST}"
echo "Outer opt    : ${OPT}"
echo "Structure    : ${STRUCTURE}"
echo "Dataset      : ${LSB_JOBINDEX}"
echo "Repo root    : ${REPO_ROOT}"
echo "=========================================================="

if command -v module >/dev/null 2>&1; then
  module load R
fi

cd "$REPO_ROOT"

# Ensure the personal library (with the required rxode2 >= 5.1.3 / nlmixr2 dev
# stack) is searched FIRST. `module load R` can prepend a site library that
# carries an older rxode2 (5.0.2), which loads before nlmixr2 can pull the new
# one and aborts with "namespace 'rxode2' 5.0.2 is already loaded, but >= 5.1.3
# is required". Setting R_LIBS_USER puts your lib ahead of the site lib.
if [ -n "${R_LIBS_USER_OVERRIDE:-}" ]; then
  export R_LIBS_USER="${R_LIBS_USER_OVERRIDE}"
fi
echo "R rxode2 check:"
Rscript -e 'cat("  libPaths:", paste(.libPaths(), collapse=" | "), "\n"); cat("  rxode2 =", as.character(packageVersion("rxode2")), "\n")' || true

# Optional repackage-only mode: REPACKAGE=1 reuses cached scm_ds*.rds and only
# rebuilds the schema-2.1 record (fast, no re-fitting) -- used to re-derive
# $scm$selected after the resFwd/resBck winner-precedence fix.
REPACK_FLAG=""
if [ "${REPACKAGE:-0}" = "1" ]; then
  REPACK_FLAG="--force_repackage"
fi

Rscript "$SCRIPTS_DIR/PerformanceEvaluation_scm_bench.R" \
    --N        "$SAMPLE_N" \
    --scenario "$SCN" \
    --estimator "$EST" \
    --outer_opt "$OPT" \
    --structure "$STRUCTURE" \
    --workers  "${WORKERS:-3}" \
    --rx_threads "${RX_THREADS:-1}" \
    --out_root "${OUT_ROOT:-output/scm_bench}" \
    --screen_sigdig "${SCREEN_SIGDIG:-NA}" \
    --screen_atol   "${SCREEN_ATOL:-NA}" \
    --screen_rtol   "${SCREEN_RTOL:-NA}" \
    --warm          "${WARM:-calc}" \
    ${REPACK_FLAG} \
    --dataset  "$LSB_JOBINDEX"

exit_code=$?
echo "=========================================================="
echo "Task finished : $(date)"
echo "Exit code     : ${exit_code}"
echo "=========================================================="
exit ${exit_code}
