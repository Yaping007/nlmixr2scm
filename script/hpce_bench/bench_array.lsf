#!/bin/bash
# ============================================================================
# bench_array.lsf
# ----------------------------------------------------------------------------
# LSF job-array template for the SCM estimator x optimizer benchmark.
# ONE task per (N, scenario, estimator, outer_opt, dataset_id).
#
# Submitted via script/hpce_bench/submit_one_array.sh which sets -J/-o/-e
# and injects env vars via `bsub -env`.
#
# Resources per task (one SCM run + tight-tol refit or in-fit cov):
#   4 CPU (nlmixr2 focei is serial within a fit; parallelism = array width)
#   6000 MB RAM (VAE ~4 GB torch cache; classical ~2 GB)
#   180 min walltime (typical N=80 fit ~15-40 min; SAEM/VAE longer)
# ============================================================================

#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -M 6000
#BSUB -W 03:00

set -euo pipefail

: "${REPO_ROOT:?REPO_ROOT must be set}"
: "${SCRIPTS_DIR:?SCRIPTS_DIR must be set (subdir with PerformanceEvaluation_scm_bench.R)}"
: "${SAMPLE_N:?SAMPLE_N must be set (40|80|300)}"
: "${SCN:?SCN must be set (1..16)}"
: "${EST:?EST must be set (focei|foceif|irlsfoceif|saem|vae)}"
: "${OPT:?OPT must be set (bobyqa|nlminb|lbfgsb3c|NA)}"
: "${LSB_JOBINDEX:?LSB_JOBINDEX must be set (LSF populates for job arrays)}"

echo "=========================================================="
echo "Task started : $(date)"
echo "Job ID       : ${LSB_JOBID}"
echo "Job name     : ${LSB_JOBNAME}"
echo "Array idx    : ${LSB_JOBINDEX}"
echo "Host         : $(hostname)"
echo "Sample N     : ${SAMPLE_N}"
echo "Scenario     : ${SCN}"
echo "Estimator    : ${EST}"
echo "Outer opt    : ${OPT}"
echo "Dataset      : ${LSB_JOBINDEX}"
echo "Repo root    : ${REPO_ROOT}"
echo "=========================================================="

if command -v module >/dev/null 2>&1; then
  module load R
fi

cd "$REPO_ROOT"

Rscript "$SCRIPTS_DIR/PerformanceEvaluation_scm_bench.R" \
    --N        "$SAMPLE_N" \
    --scenario "$SCN" \
    --estimator "$EST" \
    --outer_opt "$OPT" \
    --dataset  "$LSB_JOBINDEX"

exit_code=$?
echo "=========================================================="
echo "Task finished : $(date)"
echo "Exit code     : ${exit_code}"
echo "=========================================================="
exit ${exit_code}
