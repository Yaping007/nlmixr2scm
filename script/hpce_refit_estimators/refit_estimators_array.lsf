#!/bin/bash
# ============================================================================
# refit_estimators_array.lsf
# ----------------------------------------------------------------------------
# LSF job-array template for the TRUE-MODEL refit benchmark (no SCM search).
# ONE task per (N, scenario, estimator, outer_opt, dataset_id, boundary).
#
# Submitted via script/hpce_refit_estimators/submit_one_array.sh which sets
# -J/-o/-e and injects env vars via `bsub -env`.
#
# Resources per task (single true-model fit, no SCM, no cov refit chain):
#   2 CPU (nlmixr2 focei serial within a fit)
#   4000 MB RAM
#   60 min walltime (typical N=80 fit ~20-120 s; SAEM ~2-5 min)
# ============================================================================

#BSUB -n 2
#BSUB -R "span[hosts=1]"
#BSUB -M 4000
#BSUB -W 01:00

set -euo pipefail

: "${REPO_ROOT:?REPO_ROOT must be set}"
: "${SCRIPTS_DIR:?SCRIPTS_DIR must be set (subdir with bench_refit_estimators.R)}"
: "${SAMPLE_N:?SAMPLE_N must be set (40|80|300)}"
: "${SCN:?SCN must be set (1..16)}"
: "${EST:?EST must be set (focei|foceif|irlsfoceif|saem)}"
: "${OPT:?OPT must be set (bobyqa|nlminb|lbfgsb3c|NA)}"
: "${BND:?BND must be set (none|wide|narrow|tight)}"
: "${LSB_JOBINDEX:?LSB_JOBINDEX must be set (LSF populates for job arrays)}"

echo "=========================================================="
echo "Task started : $(date)"
echo "Job ID       : ${LSB_JOBID}"
echo "Job name     : ${LSB_JOBNAME}"
echo "Array idx    : ${LSB_JOBINDEX}"
echo "Host         : $(hostname)"
echo "Sample N     : ${SAMPLE_N}"
echo "Scenario     : ${SCN}"
echo "Estimator    : ${EST}"
echo "Outer opt    : ${OPT}"
echo "Boundary     : ${BND}"
echo "Dataset      : ${LSB_JOBINDEX}"
echo "Repo root    : ${REPO_ROOT}"
echo "=========================================================="

if command -v module >/dev/null 2>&1; then
  module load R
fi

cd "$REPO_ROOT"

Rscript "$SCRIPTS_DIR/bench_refit_estimators.R" \
    --N         "$SAMPLE_N" \
    --scenario  "$SCN" \
    --estimator "$EST" \
    --outer_opt "$OPT" \
    --boundary  "$BND" \
    --dataset   "$LSB_JOBINDEX"

exit_code=$?
echo "=========================================================="
echo "Task finished : $(date)"
echo "Exit code     : ${exit_code}"
echo "=========================================================="
exit ${exit_code}
